<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.muenchen.oss.dbs.ticketing.dprs</groupId>
    <artifactId>direct-pass-retrieval-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Direct Pass Retrieval Service</name>
    <description>Retrieves a ticket direct password through a time-limited reset link.</description>
    <url>https://github.com/it-at-m/dbs</url>

    <scm>
        <url>https://github.com/it-at-m/dbs.git</url>
        <connection>scm:git:https://github.com/it-at-m/dbs.git</connection>
        <developerConnection>scm:git:https://github.com/it-at-m/dbs.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <!-- Import dependency management from Spring Cloud -->
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2025.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-scm-plugin</artifactId>
                <version>2.2.1</version>
                <configuration>
                    <tag>RT-REL-${project.version}</tag>
                </configuration>
            </plugin>
        </plugins>
    </build>


    <modules>
        <module>webcomponent</module>
        <module>apigateway</module>
    </modules>

</project>
